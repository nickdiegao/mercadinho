# Copie para .env.local para rodar com o banco local (npm run banco:preparar).
# Sem DATABASE_URL o sistema roda como demonstracao, com os dados no navegador
# — e assim que ele roda na Vercel.

# Postgres do docker-compose.yml (porta so em 127.0.0.1)
DATABASE_URL=postgres://mercadinho:mercadinho_local@127.0.0.1:5433/mercadinho

# Assina o cookie de sessao. Gere um seu:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=troque-por-um-segredo-gerado

# Usa o endereco de cada acesso (localhost, IP da rede) em vez de um fixo
AUTH_TRUST_HOST=true

# Senha dos tres usuarios que o "npm run banco:semear" cria
# (maria@, marcos@ e jorge@distribuidora.com.br). So para teste local.
SENHA_INICIAL=Distribuidora@2026
